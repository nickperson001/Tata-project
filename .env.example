# ════════════════════════════════════════════════
# Tata Business Suite — Environment Variables
# Copy ke .env, JANGAN commit file .env ke Git
# ════════════════════════════════════════════════

# Supabase (WAJIB)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_service_role_key_here
# SUPABASE_SERVICE_KEY=your_service_role_key_here   # opsional, khusus auth bypass RLS

# DB Pool size (OPSIONAL, default: 20, min: 2, max: 50)
DB_POOL_MAX=20

# PostgreSQL untuk session store (OPSIONAL tapi sangat direkomendasikan)
# Gunakan Connection String dari Supabase: Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Admin credentials — buat di Supabase SQL Editor via:
# INSERT INTO admins (email, password_hash, role)
# VALUES ('admin@email.com', crypt('password', gen_salt('bf')), 'superadmin');

# Session secret (min 32 karakter random) - WAJIB DIGANTI!
SESSION_SECRET=ganti_dengan_random_string_32_karakter_minimal_ya

# Hugging Face untuk voice transcription (OPSIONAL)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxx

# Google Cloud Vision untuk OCR struk (WAJIB untuk fitur scan struk)
# Download service account key JSON dari Google Cloud Console
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-vision-key.json

# AI Provider — OpenRouter (WAJIB untuk NLP intent classification)
# Daftar & dapatkan key gratis di: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Payment account info (untuk customer transfer)
# Jika tidak diisi, fallback ke default BCA a.n. HANAN RIDWAN HANIF
# PAYMENT_BANK=BCA
# PAYMENT_ACCOUNT=8670662536
# PAYMENT_NAME=HANAN RIDWAN HANIF

# Railway / Production
NODE_ENV=production
PORT=3000