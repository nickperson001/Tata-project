{
  "name": "tata-business-suite",
  "version": "2.0.0",
  "description": "WhatsApp Finance Bot with Stock Opname System",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "concurrently -n backend,frontend \"tsx watch src/index.ts\" \"vite dev src/frontend\"",
    "dev:backend": "tsx watch src/index.ts",
    "dev:frontend": "vite dev src/frontend",
    "build:frontend": "vite build src/frontend",
    "build:backend": "tsc",
    "build": "npm run build:backend && npm run build:frontend",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "tsx src/scripts/seed-demo.ts"
  },
  "dependencies": {
    "@google-cloud/vision": "^4.3.3",
    "@huggingface/inference": "^4.13.15",
    "@supabase/supabase-js": "^2.39.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.79.2",
    "chart.js": "^4.4.1",
    "concurrently": "^9.2.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "html5-qrcode": "^2.3.8",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.400.0",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.0",
    "tsx": "^4.22.4",
    "tsyringe": "^4.10.0",
    "whatsapp-web.js": "^1.34.7",
    "winston": "^3.19.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.0.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "jsdom": "^25.0.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.9.0",
    "puppeteer": "^21.11.0",
    "sinon": "^22.0.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "msgpackr-extract",
    "protobufjs",
    "puppeteer"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
